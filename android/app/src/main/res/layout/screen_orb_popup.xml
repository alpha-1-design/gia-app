<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/option_capture"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Analyze Screen"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="@drawable/popup_item_bg" />

    <TextView
        android:id="@+id/option_listen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Listen"
        android:textColor="#4ade80"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_mic"
        android:drawableTint="#4ade80"
        android:drawablePadding="10dp"
        android:background="@drawable/popup_item_bg" />

    <TextView
        android:id="@+id/option_speech"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Speech: ON"
        android:textColor="#4ade80"
        android:textSize="14sp"
        android:background="@drawable/popup_item_bg" />

    <TextView
        android:id="@+id/option_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Resize"
        android:textColor="#a855f7"
        android:textSize="14sp"
        android:background="@drawable/popup_item_bg" />

    <TextView
        android:id="@+id/option_hide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Hide Orb"
        android:textColor="#f87171"
        android:textSize="14sp"
        android:background="@drawable/popup_item_bg" />

</LinearLayout>
